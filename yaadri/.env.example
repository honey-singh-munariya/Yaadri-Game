# Copy this file to .env (Windows: copy .env.example .env). `npm start` runs in production mode automatically.
# --- Required for `npm start` ---
JWT_SECRET=            # >= 24 chars. Generate one with:  npm run secret
PORT=3001

# --- Database (optional: without it YAADRI uses embedded PostgreSQL in ./data/pglite) ---
DATABASE_URL=          # postgres://user:pass@host:5432/yaadri
# PGSSL=true           # set for managed Postgres that requires SSL

# --- AI (optional: without it the demo responder is used, clearly labelled) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini     # any model available to the Responses API
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Voice (optional: without it the device voice is used, clearly labelled) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # default premade voice; use one you have access to
# ELEVENLABS_STT_MODEL=scribe_v1

# --- Site owner inbox (optional): GET /api/admin/contact with header x-admin-token ---
ADMIN_TOKEN=

# Set to false only if you serve over plain http on a non-localhost address (sessions use Secure cookies in production).
# COOKIE_SECURE=false
