{
  "name": "yaadri",
  "version": "1.0.0",
  "private": true,
  "description": "YAADRI \u2014 a world that remembers you. A cognitive game + AI memory companion (SIH26003).",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "tsx server/prod.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "secret": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('hex'))\""
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@fontsource/atkinson-hyperlegible": "^5.1.0",
    "@fontsource/baloo-2": "^5.1.0",
    "@fontsource/noto-sans-bengali": "^5.1.0",
    "@fontsource/noto-sans-devanagari": "^5.1.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "framer-motion": "^11.15.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}